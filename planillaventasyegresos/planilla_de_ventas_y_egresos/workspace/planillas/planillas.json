 "content": "[{\"id\":\"h0\",\"type\":\"header\",\"data\":{\"text\":\"<span class=\\\"h4\\\">Esta Semana</span>\",\"col\":12}},{\"id\":\"weekly\",\"type\":\"custom\",\"data\":{\"col\":12}},{\"id\":\"h1\",\"type\":\"header\",\"data\":{\"text\":\"<span class=\\\"h4\\\">Accesos Rapidos</span>\",\"col\":12}},{\"id\":\"s1\",\"type\":\"shortcut\",\"data\":{\"shortcut_name\":\"Nueva Caja\",\"col\":3}},{\"id\":\"s2\",\"type\":\"shortcut\",\"data\":{\"shortcut_name\":\"Listado de Cajas\",\"col\":3}},{\"id\":\"wqXhLrA9wm\",\"type\":\"shortcut\",\"data\":{\"shortcut_name\":\"Grafico Ventas por Sucursal\",\"col\":3}}]",
